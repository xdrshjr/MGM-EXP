# Optional: copy to .secrets/local.env (already ignored by Git).
# Used by scripts/check_local_env.py and the local IDE configurations.
# For existing project entry points, use environment variables or python -m dotenv.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
HGM_LLM_MODEL_ID=deepseek-v4-flash
PYTHONUTF8=1
PYTHONNOUSERSITE=1
PYTHONUNBUFFERED=1

